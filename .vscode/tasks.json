{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Siapkan Python (sekali saja)",
            "type": "shell",
            "command": "py -m venv .venv; if ($?) { .\\.venv\\Scripts\\python.exe -m pip install --upgrade pip; .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt }",
            "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
            "problemMatcher": []
        },
        {
            "label": "2. Jalankan Website",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
            "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
            "isBackground": true,
            "problemMatcher": [],
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "3. Uji Otomatis (cek rumus)",
            "type": "shell",
            "command": ".\\.venv\\Scripts\\python.exe tests\\uji_crud_target.py",
            "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] } },
            "problemMatcher": []
        }
    ]
}
