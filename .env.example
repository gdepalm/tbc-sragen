# Salin file ini menjadi ".env" lalu sesuaikan. JANGAN unggah file .env ke internet/GitHub.
# Lokal (default, tanpa PostgreSQL):
DATABASE_URL=sqlite:///data/tbc.db
# Server online (PostgreSQL), contoh:
# DATABASE_URL=postgresql+psycopg2://tbc:GANTI_KATA_SANDI@localhost:5432/tbc
UPLOAD_DIR=data/upload
MAX_UPLOAD_MB=200
# false = file Excel asli (berisi nama/NIK pasien) dihapus setelah diolah. Disarankan tetap false.
SIMPAN_BERKAS_ASLI=false
