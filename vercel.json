{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**,app/data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py?_vc_path=/api/$1" },
    { "src": "/(.*)", "dest": "/api/index.py?_vc_path=/$1" }
  ],
  "regions": ["sin1"]
}
